<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only (cleartext blocked). The debug/profile-only override
     lives in src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
